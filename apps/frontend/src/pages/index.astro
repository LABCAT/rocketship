---
import Button from '@rocketship/base/components/Button'
import Container from '@rocketship/base/components/Container'
import Typography from '@rocketship/base/components/Typography'
import '@rocketship/base/styles'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Rocketship</title>
  </head>
  <body>
    <Container size="content" padded>
      <Typography>
        <p class="intro-text">@rocketship/base</p>
        <h1>Rocketship</h1>
        <p>
          CSS-first Astro components. Develop in this demo app or open Storybook for the full
          catalog.
        </p>
        <p>
          <Button as="a" href="http://localhost:6006">Open Storybook</Button>
        </p>
      </Typography>
    </Container>
  </body>
</html>
