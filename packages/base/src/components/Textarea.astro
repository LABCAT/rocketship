---
import type { HTMLAttributes } from 'astro/types'

type Props = {
  class?: string
} & HTMLAttributes<'textarea'>

const { class: className, ...attrs } = Astro.props as Props
const invalid = attrs['aria-invalid'] === true || attrs['aria-invalid'] === 'true'
const classes = ['rs-textarea', invalid && 'rs-textarea--invalid', className]
// The slot is the initial value. It renders as escaped HTML, so set:html keeps entities intact,
// and trim drops the indentation that formatted markup adds around it.
const value = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : undefined
---

<textarea {...attrs} class:list={classes} set:html={value} />

<style is:global lang="scss">
  @use '../styles/mixins' as *;

  .rs-textarea {
    --rs-textarea-border-color: #{rs-token(color-border-control)};
    background: var(--rs-textarea-bg, #{rs-token(color-surface)});
    border: var(--rs-textarea-border-width, #{rs-token(border-width-sm)}) solid
      var(--rs-textarea-border-color);
    border-radius: var(--rs-textarea-border-radius, #{rs-token(radius-sm)});
    color: var(--rs-textarea-color, #{rs-token(color-fg)});
    font: inherit;
    line-height: #{rs-token(line-height-base)};
    margin: 0;
    padding-block: var(--rs-textarea-padding-block, #{rs-token(space-2)});
    padding-inline: var(--rs-textarea-padding-inline, #{rs-token(space-3)});
    resize: vertical;

    &::placeholder {
      color: #{rs-token(color-muted)};
    }

    &:focus-visible {
      outline: 2px solid #{rs-token(color-focus-ring)};
      outline-offset: 2px;
    }

    &:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }

    &--invalid {
      --rs-textarea-border-color: #{rs-token(color-danger-accent)};
    }
  }
</style>
