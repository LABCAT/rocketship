---
import Container from '@labcat2020/rocketship/components/Container'
import Field from '@labcat2020/rocketship/components/Field'
import Label from '@labcat2020/rocketship/components/Label'
import Select from '@labcat2020/rocketship/components/Select'
import Stack from '@labcat2020/rocketship/components/Stack'
---

<Container size="content" padded>
  <Stack>
    <p>Fields marked * are required.</p>
    <Field>
      <Label for="select-team" required>Team</Label>
      <Select id="select-team" name="team" required>
        <option value="" disabled selected>Choose a team</option>
        <optgroup label="Design">
          <option value="product">Product design</option>
          <option value="brand">Brand and identity</option>
        </optgroup>
        <optgroup label="Engineering">
          <option value="frontend">Frontend</option>
          <option value="backend">Backend</option>
        </optgroup>
      </Select>
    </Field>
    <Field>
      <Label for="select-plan">Billing plan</Label>
      <Select id="select-plan" name="plan" aria-invalid="true" aria-describedby="select-plan-error">
        <option value="" disabled selected>Choose a plan</option>
        <option value="starter">Starter</option>
        <option value="growth">Growth</option>
        <option value="enterprise">Enterprise</option>
      </Select>
      <p class="rs-field__error" id="select-plan-error">Choose a billing plan to continue.</p>
    </Field>
    <Field>
      <Label for="select-region">Region</Label>
      <Select id="select-region" name="region" disabled>
        <option value="eu">Europe</option>
        <option value="na">North America</option>
      </Select>
    </Field>
    <Field>
      <Label for="select-topics">Topics</Label>
      <Select id="select-topics" name="topics" multiple size="4" aria-describedby="select-topics-hint">
        <option value="components" selected>Components</option>
        <option value="tokens">Design tokens</option>
        <option value="patterns">Patterns</option>
        <option value="accessibility">Accessibility</option>
      </Select>
      <p class="rs-field__hint" id="select-topics-hint">Hold Ctrl or Cmd to choose more than one.</p>
    </Field>
  </Stack>
</Container>
