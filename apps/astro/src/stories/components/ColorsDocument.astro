---
import Card from '@labcat2020/rocketship/components/Card'
import Container from '@labcat2020/rocketship/components/Container'
import Grid from '@labcat2020/rocketship/components/Grid'
import Typography from '@labcat2020/rocketship/components/Typography'

const lightDarkExample = `:root {
  --rs-color-surface: #ffffff;
}

@media (prefers-color-scheme: dark) {
  :root {
    --rs-color-surface: #101833;
  }
}`

const consumeExample = `.rs-card {
  background: var(--rs-color-surface);
}`
---

<Container padded>
  <Typography as="article">
    <h1>Colors</h1>
    <p>
      Colour in Rocketship is a token API: <code>--rs-color-*</code> custom properties on
      <code>:root</code>. Components never hard-code palette values, so you theme the library by
      overriding those variables.
    </p>
    <p>Light and dark reuse the same names and only change the values.</p>
    <pre><code>{lightDarkExample}</code></pre>
    <p>Components keep using the same variable:</p>
    <pre><code>{consumeExample}</code></pre>
    <p>The tokens below are grouped by role.</p>
  </Typography>
</Container>

<Container>
  <Typography as="article">
    <h2>Surfaces</h2>
    <p>
      The page, the panels that sit on it, and the lines that separate them. Borders are decorative;
      control borders mark where to type and keep 3:1 against every surface. The backdrop is
      translucent and dims the page behind a modal dialog.
    </p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-bg);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Background</h3>
      <p class="rs-card__description">The page itself</p>
      <Typography slot="meta"><code>--rs-color-bg</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-surface);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Surface</h3>
      <p class="rs-card__description">Cards and panels</p>
      <Typography slot="meta"><code>--rs-color-surface</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-surface-elevated);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Elevated surface</h3>
      <p class="rs-card__description">A step up from surface</p>
      <Typography slot="meta"><code>--rs-color-surface-elevated</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-border);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Border</h3>
      <p class="rs-card__description">Hairlines and dividers</p>
      <Typography slot="meta"><code>--rs-color-border</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-border-control);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Control border</h3>
      <p class="rs-card__description">Edges of inputs (3:1)</p>
      <Typography slot="meta"><code>--rs-color-border-control</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-backdrop);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Backdrop</h3>
      <p class="rs-card__description">Dims the page behind a dialog</p>
      <Typography slot="meta"><code>--rs-color-backdrop</code></Typography>
    </Card>
  </Grid>
</Container>

<Container>
  <Typography as="article">
    <h2>Text</h2>
    <p>What you read. Foreground for body copy, muted for labels and supporting text.</p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-fg);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Foreground</h3>
      <p class="rs-card__description">Body text</p>
      <Typography slot="meta"><code>--rs-color-fg</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-muted);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Muted</h3>
      <p class="rs-card__description">Labels and captions</p>
      <Typography slot="meta"><code>--rs-color-muted</code></Typography>
    </Card>
  </Grid>
</Container>

<Container>
  <Typography as="article">
    <h2>Interactive</h2>
    <p>
      Buttons, links, and keyboard focus. Accent contrast is only for text and marks that sit on
      accent.
    </p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-accent);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Accent</h3>
      <p class="rs-card__description">Primary actions</p>
      <Typography slot="meta"><code>--rs-color-accent</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-accent-contrast);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Accent contrast</h3>
      <p class="rs-card__description">Text and marks on accent</p>
      <Typography slot="meta"><code>--rs-color-accent-contrast</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-accent-text);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Accent text</h3>
      <p class="rs-card__description">Accent-coloured text on page surfaces</p>
      <Typography slot="meta"><code>--rs-color-accent-text</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-accent-hover);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Accent hover</h3>
      <p class="rs-card__description">Accent fills under the pointer</p>
      <Typography slot="meta"><code>--rs-color-accent-hover</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-link);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Link</h3>
      <p class="rs-card__description">Unvisited links</p>
      <Typography slot="meta"><code>--rs-color-link</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-link-hover);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Link hover</h3>
      <p class="rs-card__description">Link at hover</p>
      <Typography slot="meta"><code>--rs-color-link-hover</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-link-visited);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Link visited</h3>
      <p class="rs-card__description">Visited links</p>
      <Typography slot="meta"><code>--rs-color-link-visited</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-focus-ring);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Focus ring</h3>
      <p class="rs-card__description">Keyboard focus</p>
      <Typography slot="meta"><code>--rs-color-focus-ring</code></Typography>
    </Card>
  </Grid>
</Container>
<Container>
  <Typography as="article">
    <h2>Status</h2>
    <p>
      Feedback for outcomes: info, success, warning, and danger. Each role has a background, border,
      foreground, and accent pair, so components like Alert stay readable in light and dark.
    </p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-accent);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Info accent</h3>
      <p class="rs-card__description">Neutral information</p>
      <Typography slot="meta"><code>--rs-color-accent</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-success-accent);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Success accent</h3>
      <p class="rs-card__description">Positive outcomes</p>
      <Typography slot="meta"><code>--rs-color-success-accent</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-warning-accent);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Warning accent</h3>
      <p class="rs-card__description">Caution and limits</p>
      <Typography slot="meta"><code>--rs-color-warning-accent</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-danger-accent);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Danger accent</h3>
      <p class="rs-card__description">Errors and failures</p>
      <Typography slot="meta"><code>--rs-color-danger-accent</code></Typography>
    </Card>
  </Grid>
</Container>

<Container>
  <Typography as="article">
    <h3>Success</h3>
    <p>
      The full success palette. Backgrounds and borders tint containers, the foreground keeps text
      readable on them, and the accent draws the eye.
    </p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-success-bg);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Success background</h3>
      <p class="rs-card__description">Container fill</p>
      <Typography slot="meta"><code>--rs-color-success-bg</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-success-border);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Success border</h3>
      <p class="rs-card__description">Container edge</p>
      <Typography slot="meta"><code>--rs-color-success-border</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-success-fg);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Success foreground</h3>
      <p class="rs-card__description">Text on success surfaces</p>
      <Typography slot="meta"><code>--rs-color-success-fg</code></Typography>
    </Card>
  </Grid>
</Container>

<Container>
  <Typography as="article">
    <h3>Warning</h3>
    <p>The full warning palette, following the same background, border, foreground structure.</p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-warning-bg);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Warning background</h3>
      <p class="rs-card__description">Container fill</p>
      <Typography slot="meta"><code>--rs-color-warning-bg</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-warning-border);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Warning border</h3>
      <p class="rs-card__description">Container edge</p>
      <Typography slot="meta"><code>--rs-color-warning-border</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-warning-fg);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Warning foreground</h3>
      <p class="rs-card__description">Text on warning surfaces</p>
      <Typography slot="meta"><code>--rs-color-warning-fg</code></Typography>
    </Card>
  </Grid>
</Container>

<Container>
  <Typography as="article">
    <h3>Danger</h3>
    <p>
      The full danger palette, following the same background, border, foreground structure, plus
      danger text for red text that sits on page surfaces, such as form errors.
    </p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-danger-bg);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Danger background</h3>
      <p class="rs-card__description">Container fill</p>
      <Typography slot="meta"><code>--rs-color-danger-bg</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-danger-border);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Danger border</h3>
      <p class="rs-card__description">Container edge</p>
      <Typography slot="meta"><code>--rs-color-danger-border</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-danger-fg);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Danger foreground</h3>
      <p class="rs-card__description">Text on danger surfaces</p>
      <Typography slot="meta"><code>--rs-color-danger-fg</code></Typography>
    </Card>
    <Card as="li" style="--rs-card-media-bg: var(--rs-color-danger-text);">
      <div slot="media" class="rs-card__media"></div>
      <h3 class="rs-card__title">Danger text</h3>
      <p class="rs-card__description">Error text on page surfaces</p>
      <Typography slot="meta"><code>--rs-color-danger-text</code></Typography>
    </Card>
  </Grid>
</Container>
