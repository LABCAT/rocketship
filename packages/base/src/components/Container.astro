---
import type { HTMLAttributes } from 'astro/types'

export type ContainerSize = 'default' | 'full' | 'wide' | 'content'
export type ContainerTag = 'div' | 'section' | 'main' | 'article' | 'header' | 'footer' | 'nav'

type Props = {
  as?: ContainerTag
  size?: ContainerSize
  padded?: boolean
  flush?: boolean
  class?: string
} & HTMLAttributes<'div'>

const {
  as = 'div',
  size = 'default',
  padded = false,
  flush = false,
  class: className,
  ...attrs
} = Astro.props as Props

const Tag = as
const classes = [
  'rs-container',
  size !== 'default' && `rs-container--${size}`,
  padded && 'rs-container--padded',
  flush && 'rs-container--flush',
  className,
]
---

<Tag {...attrs} class:list={classes}>
  <slot />
</Tag>

<style is:global lang="scss">
  @use '../styles/mixins' as *;

  .rs-container {
    --rs-container-width: #{rs-token(container-width-default)};
    --rs-container-inset-inline: #{rs-token(container-gutter)};
    --rs-container-gutter-left: max(env(safe-area-inset-left), var(--rs-container-inset-inline));
    --rs-container-gutter-right: max(env(safe-area-inset-right), var(--rs-container-inset-inline));
    --rs-container-gutters: calc(
      var(--rs-container-gutter-left) + var(--rs-container-gutter-right)
    );
    --rs-container-inset-block: 0px;
    --rs-container-gutter-top: max(
      env(safe-area-inset-top),
      var(--rs-container-padding-block-start, var(--rs-container-inset-block))
    );
    --rs-container-gutter-bottom: max(
      env(safe-area-inset-bottom),
      var(--rs-container-padding-block-end, var(--rs-container-inset-block))
    );
    container-type: inline-size;
    margin-inline: auto;
    max-inline-size: calc(var(--rs-container-width) + var(--rs-container-gutters));
    padding-block: var(--rs-container-gutter-top) var(--rs-container-gutter-bottom);
    padding-inline: var(--rs-container-gutter-left) var(--rs-container-gutter-right);
    inline-size: 100%;

    &--content {
      --rs-container-width: #{rs-token(container-width-content-sm)};

      @include media-breakpoint-up(lg) {
        --rs-container-width: #{rs-token(container-width-content-lg)};
      }
    }

    &--wide {
      --rs-container-width: #{rs-token(container-width-wide)};
    }

    &--full {
      --rs-container-width: 100%;
    }

    &--padded {
      --rs-container-inset-block: #{rs-token(container-padding-block)};
    }

    &--flush {
      --rs-container-inset-inline: 0px;
    }
  }
</style>
