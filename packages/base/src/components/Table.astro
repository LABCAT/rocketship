---
import type { HTMLAttributes } from 'astro/types'

type Props = {
  striped?: boolean
  class?: string
} & HTMLAttributes<'table'>

const { striped = false, class: className, ...attrs } = Astro.props as Props
const classes = ['rs-table', striped && 'rs-table--striped', className]
---

<table {...attrs} class:list={classes}>
  <slot />
</table>

<style is:global lang="scss">
  @use '../styles/mixins' as *;

  .rs-table {
    border-collapse: separate;
    border-spacing: 0;
    inline-size: 100%;
    background: var(--rs-table-bg, #{rs-token(color-surface)});
    border: var(--rs-table-border-width, #{rs-token(border-width-sm)}) solid
      var(--rs-table-border-color, #{rs-token(color-border)});
    border-radius: var(--rs-table-border-radius, #{rs-token(radius-md)});
    clip-path: inset(0 round var(--rs-table-border-radius, #{rs-token(radius-md)}));
    color: var(--rs-table-color, #{rs-token(color-fg)});
    text-align: start;

    &--striped {
      --rs-table-stripe-bg: #{rs-token(color-surface-elevated)};
    }

    &__caption {
      color: var(--rs-table-caption-color, #{rs-token(color-fg)});
      font-size: inherit;
      font-weight: var(--rs-table-caption-font-weight, #{rs-token(font-weight-semibold)});
      line-height: #{rs-token(line-height-tight)};
      padding-block-end: #{rs-token(space-2)};
      text-align: start;
    }

    &__body-row:nth-child(even) {
      background: var(--rs-table-stripe-bg, transparent);
    }

    &__body-row:last-child,
    &__foot-row:last-child {
      --rs-table-row-divider-width: 0;
    }

    &__foot-row {
      --rs-table-cell-font-weight: #{rs-token(font-weight-semibold)};
    }

    &__foot-row:first-child {
      --rs-table-row-divider-start-width: var(
        --rs-table-border-width,
        #{rs-token(border-width-sm)}
      );
    }

    &__column-header,
    &__row-header,
    &__cell {
      border-block-start: var(--rs-table-row-divider-start-width, 0) solid
        var(--rs-table-border-color, #{rs-token(color-border)});
      border-block-end: var(
          --rs-table-row-divider-width,
          var(--rs-table-border-width, #{rs-token(border-width-sm)})
        )
        solid var(--rs-table-border-color, #{rs-token(color-border)});
      padding-block: var(--rs-table-cell-padding-block, #{rs-token(space-2)});
      padding-inline: var(--rs-table-cell-padding-inline, #{rs-token(space-3)});
    }

    &__column-header,
    &__row-header {
      color: var(--rs-table-color, #{rs-token(color-fg)});
      font-weight: var(--rs-table-header-font-weight, #{rs-token(font-weight-semibold)});
      text-align: inherit;
    }

    &__column-header {
      background: var(--rs-table-head-bg, #{rs-token(color-surface-elevated)});
      vertical-align: bottom;
    }

    &__row-header,
    &__cell {
      vertical-align: top;
    }

    &__cell {
      color: var(--rs-table-color, #{rs-token(color-fg)});
      font-weight: var(--rs-table-cell-font-weight, inherit);
    }

    &__column-header--numeric,
    &__cell--numeric {
      font-variant-numeric: tabular-nums;
      text-align: end;
    }
  }
</style>
