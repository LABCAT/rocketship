{
  "$description": "Rocketship colours and shadows, dark mode.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0235, 0.0431, 0.0941],
        "hex": "#060b18"
      }
    },
    "fg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9647, 0.9686, 1],
        "hex": "#f6f7ff"
      }
    },
    "surface": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0627, 0.0941, 0.2],
          "hex": "#101833"
        }
      },
      "elevated": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0941, 0.1412, 0.2941],
          "hex": "#18244b"
        }
      }
    },
    "border": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1922, 0.2549, 0.4353],
          "hex": "#31416f"
        }
      },
      "control": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3647, 0.4353, 0.6235],
          "hex": "#5d6f9f"
        }
      }
    },
    "accent": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3098, 0.5373, 1],
          "hex": "#4f89ff"
        }
      },
      "contrast": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0235, 0.0431, 0.0941],
          "hex": "#060b18"
        }
      }
    },
    "link": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5294, 0.7098, 1],
          "hex": "#87b5ff"
        }
      },
      "hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6745, 0.8039, 1],
          "hex": "#accdff"
        }
      },
      "visited": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7569, 0.6431, 1],
          "hex": "#c1a4ff"
        }
      }
    },
    "focus-ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4863, 0.7804, 1],
        "hex": "#7cc7ff"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7647, 0.7961, 0.9176],
        "hex": "#c3cbea"
      }
    },
    "backdrop": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0235, 0.0431, 0.0941],
        "alpha": 0.7,
        "hex": "#060b18"
      }
    },
    "success": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0588, 0.1647, 0.0941],
          "hex": "#0f2a18"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1647, 0.3647, 0.2275],
          "hex": "#2a5d3a"
        }
      },
      "fg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.851, 0.9412, 0.8745],
          "hex": "#d9f0df"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.298, 0.6863, 0.4157],
          "hex": "#4caf6a"
        }
      }
    },
    "warning": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1804, 0.1373, 0],
          "hex": "#2e2300"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5412, 0.4275, 0.1059],
          "hex": "#8a6d1b"
        }
      },
      "fg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.9529, 0.8118],
          "hex": "#fff3cf"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.749, 0.2392],
          "hex": "#ffbf3d"
        }
      }
    },
    "danger": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1804, 0.0392, 0.0588],
          "hex": "#2e0a0f"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5412, 0.1647, 0.1882],
          "hex": "#8a2a30"
        }
      },
      "fg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.8863, 0.8941],
          "hex": "#ffe2e4"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.4196, 0.4196],
          "hex": "#ff6b6b"
        }
      },
      "text": {
        "$value": "{color.danger.accent}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 0.2,
          "hex": "#ffffff"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 0,
          "unit": "px"
        },
        "spread": {
          "value": 1,
          "unit": "px"
        }
      }
    },
    "md": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 0.4,
          "hex": "#ffffff"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 8,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 0.6,
          "hex": "#ffffff"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 16,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
