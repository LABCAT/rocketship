---
import Container from '@labcat/rocketship/components/Container'
import Typography from '@labcat/rocketship/components/Typography'
import FileInput from '@labcat/rocketship/components/FileInput'
---

<Container size="content" padded>
  <Typography>
    <p>File input states: disabled and invalid.</p>
  </Typography>
  <FileInput label="Upload an export" disabled name="export" />
  <FileInput label="Add proof of identity" invalid required name="proof" />
</Container>
