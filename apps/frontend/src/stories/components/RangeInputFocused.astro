import RangeInput from '@labcat/rocketship/components/RangeInput'
---

<Container size="content" padded>
  <label for="range-focus">Focused contrast</label>
  <RangeInput autofocus id="range-focus" max={100} min={0} name="focus-level" value={45} />
</Container>
