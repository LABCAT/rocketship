---
import Container from '@labcat/rocketship/components/Container'
import Fieldset from '@labcat/rocketship/components/Fieldset'
---

<Container size="content" padded>
  <Fieldset legend="Billing address" disabled>
    <label for="billing-name-disabled">Name</label>
    <input id="billing-name-disabled" type="text" />
    <label for="billing-address-disabled">Address</label>
    <input id="billing-address-disabled" type="text" />
  </Fieldset>
</Container>
