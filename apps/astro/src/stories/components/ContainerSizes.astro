---
import Card from '@labcat2020/rocketship/components/Card'
import Container from '@labcat2020/rocketship/components/Container'
---

<Container size="content" padded>
  <Card>
    <h2 class="rs-card__title">Content</h2>
    <p class="rs-card__description">600px, then 800px from 992px.</p>
  </Card>
</Container>
<Container padded>
  <Card>
    <h2 class="rs-card__title">Default</h2>
    <p class="rs-card__description">1000px.</p>
  </Card>
</Container>
<Container size="wide" padded>
  <Card>
    <h2 class="rs-card__title">Wide</h2>
    <p class="rs-card__description">1200px.</p>
  </Card>
</Container>
<Container size="full" padded>
  <Card>
    <h2 class="rs-card__title">Full</h2>
    <p class="rs-card__description">The whole width of the page.</p>
  </Card>
</Container>
