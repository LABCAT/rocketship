{
  "$description": "Rocketship colours and shadows, light mode.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9647, 0.9725, 1],
        "hex": "#f6f8ff"
      }
    },
    "fg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0745, 0.102, 0.1843],
        "hex": "#131a2f"
      }
    },
    "surface": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      },
      "elevated": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9333, 0.949, 1],
          "hex": "#eef2ff"
        }
      }
    },
    "border": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7843, 0.8235, 0.9216],
          "hex": "#c8d2eb"
        }
      },
      "control": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4941, 0.5373, 0.6588],
          "hex": "#7e89a8"
        }
      }
    },
    "accent": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1843, 0.3569, 0.8588],
          "hex": "#2f5bdb"
        }
      },
      "contrast": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      }
    },
    "link": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1216, 0.2863, 0.7765],
          "hex": "#1f49c6"
        }
      },
      "hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0902, 0.2431, 0.6588],
          "hex": "#173ea8"
        }
      },
      "visited": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4157, 0.2471, 0.7608],
          "hex": "#6a3fc2"
        }
      }
    },
    "focus-ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1608, 0.4275, 1],
        "hex": "#296dff"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.3098, 0.3569, 0.4902],
        "hex": "#4f5b7d"
      }
    },
    "success": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.902, 0.9569, 0.9176],
          "hex": "#e6f4ea"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6549, 0.8471, 0.7098],
          "hex": "#a7d8b5"
        }
      },
      "fg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0588, 0.1647, 0.0941],
          "hex": "#0f2a18"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.102, 0.4784, 0.1961],
          "hex": "#1a7a32"
        }
      }
    },
    "warning": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.9725, 0.8824],
          "hex": "#fff8e1"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9412, 0.7647, 0.4157],
          "hex": "#f0c36a"
        }
      },
      "fg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2392, 0.1569, 0],
          "hex": "#3d2800"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6039, 0.3647, 0],
          "hex": "#9a5d00"
        }
      }
    },
    "danger": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.9333, 0.9412],
          "hex": "#ffeef0"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9412, 0.6588, 0.6902],
          "hex": "#f0a8b0"
        }
      },
      "fg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2392, 0.0392, 0.0314],
          "hex": "#3d0a08"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7725, 0.1333, 0.1216],
          "hex": "#c5221f"
        }
      },
      "text": {
        "$value": "{color.danger.accent}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0745, 0.102, 0.1843],
          "alpha": 0.2,
          "hex": "#131a2f"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "md": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0745, 0.102, 0.1843],
          "alpha": 0.4,
          "hex": "#131a2f"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 8,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0745, 0.102, 0.1843],
          "alpha": 0.6,
          "hex": "#131a2f"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 8,
          "unit": "px"
        },
        "blur": {
          "value": 24,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
