---
import Card from '@labcat/rocketship/components/Card'
import Container from '@labcat/rocketship/components/Container'
import Grid from '@labcat/rocketship/components/Grid'
import Typography from '@labcat/rocketship/components/Typography'

const spaces = [
  { name: '1', value: '4px' },
  { name: '2', value: '8px' },
  { name: '3', value: '12px' },
  { name: '4', value: '16px' },
  { name: '5', value: '20px' },
  { name: '6', value: '24px' },
  { name: '7', value: '32px' },
  { name: '8', value: '40px' },
]

const overrideExample = `:root {
  --rs-space-4: 18px;
}`

const consumeExample = `.rs-card__body {
  padding: var(--rs-space-4);
}`

const instanceOverrideExample = `<Card style="--rs-card-body-padding: var(--rs-space-6)">
  ...
</Card>`
---

<Container padded>
  <Typography as="article">
    <h1>Spacing</h1>
    <p>
      Spacing in Rocketship is a token API: <code>--rs-space-*</code> custom properties on
      <code>:root</code>. Components never hard-code gaps or padding, so you retune the whole
      library by overriding those variables.
    </p>
    <p>The scale is a simple 4px-based ramp from 4px to 40px.</p>
    <pre><code>{overrideExample}</code></pre>
    <p>Components keep using the same variable:</p>
    <pre><code>{consumeExample}</code></pre>
    <p>
      Components also expose opt-in override hooks named
      <code>--rs-&lt;component&gt;-&lt;part&gt;-&lt;property&gt;</code>. These are never defined by the
      library — they exist only so you can restyle a single instance without touching the global scale:
    </p>
    <pre><code>{instanceOverrideExample}</code></pre>
    <p>The tokens below are shown at their actual size.</p>
  </Typography>
</Container>

<Container>
  <Typography as="article">
    <h2>Scale</h2>
    <p>Each bar is exactly as wide as its token.</p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={2}>
    {spaces.map((space) => (
      <Card as="li">
        <div
          style={`width: var(--rs-space-${space.name}); background: var(--rs-color-accent); border-radius: var(--rs-radius-sm); height: var(--rs-space-3); margin-block-end: var(--rs-space-2);`}
          aria-hidden="true"
        />
        <p class="rs-card__title">Space {space.name}</p>
        <p class="rs-card__description">{space.value}</p>
        <span slot="meta" class="rs-card__token">--rs-space-{space.name}</span>
      </Card>
    ))}
  </Grid>
</Container>
