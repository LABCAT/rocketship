---
import type { HTMLAttributes } from 'astro/types'

type Props = {
  id?: string
  name?: string
  min?: number
  max?: number
  step?: number
  value?: number
  label?: string
  list?: string
  disabled?: boolean
  invalid?: boolean
  required?: boolean
  class?: string
} & HTMLAttributes<'input'>

const {
  id,
  name,
  min,
  max,
  step,
  value,
  label,
  list,
  disabled = false,
  invalid = false,
  required = false,
  class: className,
  ...attrs
} = Astro.props as Props

const classes = ['rs-range-input', invalid ? 'rs-range-input--invalid' : undefined, className]
---

<input
  {...attrs}
  aria-invalid={invalid || undefined}
  aria-label={label}
  class:list={classes}
  disabled={disabled || undefined}
  id={id}
  list={list}
  max={max}
  min={min}
  name={name}
  required={required || undefined}
  step={step}
  type="range"
  value={value}
/>

<style is:global lang="scss">
  @use '../styles/mixins' as *;

  .rs-range-input {
    --rs-range-track-color: var(--rs-color-border, #c8d2eb);
    --rs-range-track-height: 4px;
    --rs-range-thumb-bg: var(--rs-color-surface, #ffffff);
    --rs-range-thumb-border-color: var(--rs-color-accent, #2f5bdb);
    --rs-range-thumb-border-width: var(--rs-border-width-md, 2px);
    --rs-range-thumb-size: 20px;
    --rs-range-focus-ring-color: var(--rs-color-focus-ring, #296dff);
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    box-sizing: border-box;
    cursor: pointer;
    height: var(--rs-range-height, calc(var(--rs-range-thumb-size, 20px) + var(--rs-space-2, 8px)));
    margin: 0;
    width: 100%;

    &:focus,
    &:focus-visible {
      outline: 2px solid var(--rs-range-focus-ring-color);
      outline-offset: 2px;
    }

    &:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }

    &::-webkit-slider-runnable-track {
      background: var(--rs-range-track-color);
      border-radius: var(--rs-radius-pill, 999px);
      height: var(--rs-range-track-height);
    }

    &::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      background: var(--rs-range-thumb-bg);
      border: var(--rs-range-thumb-border-width) solid var(--rs-range-thumb-border-color);
      border-radius: 50%;
      box-sizing: border-box;
      height: var(--rs-range-thumb-size);
      margin-top: calc((var(--rs-range-track-height) - var(--rs-range-thumb-size)) / 2);
      width: var(--rs-range-thumb-size);
    }

    &::-moz-range-track {
      background: var(--rs-range-track-color);
      border-radius: var(--rs-radius-pill, 999px);
      height: var(--rs-range-track-height);
    }

    &::-moz-range-thumb {
      background: var(--rs-range-thumb-bg);
      border: var(--rs-range-thumb-border-width) solid var(--rs-range-thumb-border-color);
      border-radius: 50%;
      box-sizing: border-box;
      height: var(--rs-range-thumb-size);
      width: var(--rs-range-thumb-size);
    }

    &--invalid {
      --rs-range-track-color: var(--rs-color-danger-accent, #c5221f);
      --rs-range-thumb-border-color: var(--rs-color-danger-accent, #c5221f);
      --rs-range-focus-ring-color: var(--rs-color-danger-accent, #c5221f);
    }

    @include container-query-up($rs-cq-sm) {
      --rs-range-track-height: var(--rs-range-track-height-cq, 6px);
      --rs-range-thumb-size: var(--rs-range-thumb-size-cq, 24px);
    }
  }
</style>
