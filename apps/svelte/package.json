    "@storybook/svelte": "10.5.8",
    "@storybook/svelte-vite": "10.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "sass": "^1.98.0",
    "storybook": "10.5.8",
    "svelte": "^5.57.2",
    "vite": "^8.2.1"
  }
