---
import Button from '@labcat2020/rocketship/components/Button'
import Stack from '@labcat2020/rocketship/components/Stack'
---

<Stack gap="small">
  <div>
    <Button>Deploy</Button>{' '}
    <Button variant="secondary">Preview</Button>{' '}
    <Button variant="ghost">Cancel</Button>
  </div>
  <div>
    <Button href="https://docs.astro.build/en/guides/deploy/">Read the deploy guide</Button>{' '}
    <Button disabled>Deploying</Button>
  </div>
</Stack>
