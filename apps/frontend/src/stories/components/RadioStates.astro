---
import Container from '@labcat/rocketship/components/Container'
import Radio from '@labcat/rocketship/components/Radio'
---

<Container size="content" padded>
  <Radio name="delivery" value="unchecked"> Unchecked </Radio>
  <Radio name="delivery" value="checked" checked> Checked </Radio>
  <Radio name="delivery" value="disabled" disabled> Disabled </Radio>
  <Radio name="delivery" value="disabled-checked" checked disabled> Disabled checked </Radio>
  <Radio name="delivery" value="invalid" invalid> Invalid </Radio>
</Container>
