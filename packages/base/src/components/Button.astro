---
import type { HTMLAttributes } from 'astro/types'

export type ButtonVariant = 'primary' | 'secondary' | 'ghost'
export type ButtonSize = 'small' | 'medium' | 'large'

type NativeButtonType = 'button' | 'submit' | 'reset'

type Props = {
  href?: string
  variant?: ButtonVariant
  size?: ButtonSize
  disabled?: boolean
  type?: NativeButtonType
  class?: string
} & HTMLAttributes<'button'> &
  HTMLAttributes<'a'>

const {
  href,
  variant = 'primary',
  size = 'medium',
  disabled = false,
  type = 'button',
  class: className,
  ...attrs
} = Astro.props as Props

const shouldRenderAsLink = Boolean(href)

const classes = [
  'rs-button',
  variant !== 'primary' && `rs-button--${variant}`,
  size !== 'medium' && `rs-button--${size}`,
  shouldRenderAsLink && disabled && 'rs-button--disabled',
  className,
]
---

{
  shouldRenderAsLink ? (
    <a
      {...attrs}
      aria-disabled={disabled || undefined}
      class:list={classes}
      href={disabled ? undefined : href}
      role={disabled ? 'link' : undefined}
      tabindex={disabled ? -1 : undefined}
    >
      <slot />
    </a>
  ) : (
    <button {...attrs} class:list={classes} disabled={disabled} type={type}>
      <slot />
    </button>
  )
}

<style is:global lang="scss">
  @use '../styles/mixins' as *;

  .rs-button {
    --rs-button-bg: #{rs-token(color-accent)};
    --rs-button-color: #{rs-token(color-accent-contrast)};
    --rs-button-border-color: #{rs-token(color-accent)};
    --rs-button-border-width: #{rs-token(border-width-sm)};
    --rs-button-hover-bg: #{rs-token(color-accent-hover)};
    --rs-button-hover-border-color: #{rs-token(color-accent-hover)};
    --rs-button-font-size: 100%;
    /// Medium lines up with Input: one line of `line-height-base` text, `space-2` above and
    /// below, and a 1px edge.
    --rs-button-min-block-size: calc(
      #{rs-token(line-height-base)} * 1em + 2 * #{rs-token(space-2)} + 2 *
        #{rs-token(border-width-sm)}
    );
    --rs-button-padding-inline: #{rs-token(space-4)};
    --rs-button-duration: var(--rs-button-transition-duration, #{rs-token(transition-fast)});
    all: unset;
    box-sizing: border-box;
    align-items: center;
    display: inline-flex;
    gap: var(--rs-button-gap, #{rs-token(space-2)});
    justify-content: center;
    min-block-size: var(--rs-button-min-block-size);
    padding-inline: var(--rs-button-padding-inline);
    background: var(--rs-button-bg);
    border: var(--rs-button-border-width) solid var(--rs-button-border-color);
    border-radius: var(--rs-button-border-radius, #{rs-token(radius-pill)});
    color: var(--rs-button-color);
    cursor: pointer;
    font-size: var(--rs-button-font-size);
    font-weight: var(--rs-button-font-weight, #{rs-token(font-weight-semibold)});
    line-height: #{rs-token(line-height-tight)};
    text-decoration: none;
    transition:
      background-color var(--rs-button-duration) ease,
      border-color var(--rs-button-duration) ease,
      color var(--rs-button-duration) ease,
      opacity var(--rs-button-duration) ease;
    white-space: nowrap;

    @media (prefers-reduced-motion: reduce) {
      --rs-button-duration: 0s;
    }

    &:hover {
      --rs-button-bg: var(--rs-button-hover-bg);
      --rs-button-border-color: var(--rs-button-hover-border-color);
    }

    &:active {
      filter: brightness(0.94);
    }

    &:focus-visible {
      outline: 2px solid #{rs-token(color-focus-ring)};
      outline-offset: 2px;
    }

    &:disabled,
    &--disabled {
      opacity: 0.55;
      pointer-events: none;
    }

    &--secondary {
      --rs-button-bg: #{rs-token(color-surface)};
      --rs-button-border-color: #{rs-token(color-accent)};
      --rs-button-border-width: #{rs-token(border-width-md)};
      --rs-button-color: #{rs-token(color-accent-text)};
      --rs-button-hover-bg: color-mix(
        in srgb,
        #{rs-token(color-accent)} 10%,
        #{rs-token(color-surface)}
      );
      --rs-button-hover-border-color: #{rs-token(color-accent)};
    }

    &--ghost {
      --rs-button-bg: transparent;
      --rs-button-border-color: transparent;
      --rs-button-border-width: #{rs-token(border-width-md)};
      --rs-button-color: #{rs-token(color-accent-text)};
      --rs-button-hover-bg: color-mix(in srgb, #{rs-token(color-accent)} 10%, transparent);
      --rs-button-hover-border-color: transparent;
    }

    &--small {
      --rs-button-min-block-size: 32px;
      --rs-button-padding-inline: #{rs-token(space-3)};
    }

    &--large {
      --rs-button-font-size: #{rs-token(font-size-lg)};
      --rs-button-min-block-size: 48px;
      --rs-button-padding-inline: #{rs-token(space-6)};
    }
  }
</style>
