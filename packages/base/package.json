{
  "name": "@labcat2020/rocketship",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Rocketship — Astro-focused, CSS-first component library: design tokens, default theme, and core components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LABCAT/rocketship.git",
    "directory": "packages/base"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./src/styles/css.d.ts",
      "import": "./src/styles/index.scss",
      "default": "./src/styles/index.scss"
    },
    "./styles/mixins": {
      "types": "./src/styles/css.d.ts",
      "import": "./src/styles/mixins.scss",
      "default": "./src/styles/mixins.scss"
    },
    "./tokens/*": "./src/tokens/*",
    "./components/Button": "./src/components/Button.astro",
    "./components/Card": "./src/components/Card.astro",
    "./components/Container": "./src/components/Container.astro",
    "./components/Fieldset": "./src/components/Fieldset.astro",
    "./components/Grid": "./src/components/Grid.astro",
    "./components/Stack": "./src/components/Stack.astro",
    "./components/Scroll": "./src/components/Scroll.astro",
    "./components/Typography": "./src/components/Typography.astro",
    "./components/Alert": "./src/components/Alert.astro",
    "./components/Field": "./src/components/Field.astro",
    "./components/Label": "./src/components/Label.astro",
    "./components/Input": "./src/components/Input.astro",
    "./components/Textarea": "./src/components/Textarea.astro",
    "./components/Select": "./src/components/Select.astro",
    "./components/Checkbox": "./src/components/Checkbox.astro",
    "./components/Radio": "./src/components/Radio.astro",
    "./components/Table": "./src/components/Table.astro",
    "./components/Figure": "./src/components/Figure.astro",
    "./components/Disclosure": "./src/components/Disclosure.astro",
    "./components/FileInput": "./src/components/FileInput.astro",
    "./components/RangeInput": "./src/components/RangeInput.astro",
    "./components/Popover": "./src/components/Popover.astro",
    "./components/Tooltip": "./src/components/Tooltip.astro"
  },
  "files": [
    "dist",
    "src/styles",
    "src/tokens",
    "src/components",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs && tsc -p tsconfig.json",
    "test": "node --test",
    "tokens": "node scripts/build-tokens.mjs"
  }
}
