{
  "name": "@rocketship/svelte-storybook",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Svelte Storybook host for Rocketship",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6007",
