---
import Button from '@labcat2020/rocketship/components/Button'
import Container from '@labcat2020/rocketship/components/Container'
import Stack from '@labcat2020/rocketship/components/Stack'

const sizes = ['small', 'medium', 'large'] as const
---

<Container size="content" padded>
  <Stack gap="small">
    {
      sizes.map((size) => (
        <div>
          <Button size={size}>Deploy</Button>{' '}
          <Button size={size} variant="secondary">
            Preview
          </Button>{' '}
          <Button size={size} variant="ghost">
            Cancel
          </Button>
        </div>
      ))
    }
  </Stack>
</Container>
