---
import Container from '@labcat/rocketship/components/Container'
import Fieldset from '@labcat/rocketship/components/Fieldset'
---

<Container size="content" padded>
  <Fieldset legend="Billing address">
    <label for="billing-name">Name</label>
    <input id="billing-name" type="text" />
    <label for="billing-address">Address</label>
    <input id="billing-address" type="text" />
  </Fieldset>
</Container>
