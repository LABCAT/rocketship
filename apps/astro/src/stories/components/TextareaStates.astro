---
import Container from '@labcat2020/rocketship/components/Container'
import Field from '@labcat2020/rocketship/components/Field'
import Label from '@labcat2020/rocketship/components/Label'
import Stack from '@labcat2020/rocketship/components/Stack'
import Textarea from '@labcat2020/rocketship/components/Textarea'
---

<Container size="content" padded>
  <Stack gap="large">
    <Field>
      <Label for="textarea-default">Message</Label>
      <Textarea id="textarea-default" rows="4" placeholder="How can we help?" />
    </Field>
    <Field>
      <Label for="textarea-invalid">Description</Label>
      <Textarea
        id="textarea-invalid"
        rows="4"
        aria-invalid="true"
        aria-describedby="textarea-invalid-error"
      >
        Too short
      </Textarea>
      <p class="rs-field__error" id="textarea-invalid-error">
        Write at least 20 characters so reviewers have context.
      </p>
    </Field>
    <Field>
      <Label for="textarea-disabled">Previous notes</Label>
      <Textarea id="textarea-disabled" rows="3" disabled>Imported from the old system.</Textarea>
    </Field>
  </Stack>
</Container>
