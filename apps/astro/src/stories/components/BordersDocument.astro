---
import Card from '@labcat2020/rocketship/components/Card'
import Container from '@labcat2020/rocketship/components/Container'
import Grid from '@labcat2020/rocketship/components/Grid'
import Typography from '@labcat2020/rocketship/components/Typography'

const instanceOverrideExample = `/* your-theme.scss */
:root {
  --rs-card-border-radius: 0;
}`

const radii = [
  { name: 'sm', value: '6px' },
  { name: 'md', value: '10px' },
  { name: 'pill', value: '999px' },
]

const widths = [
  { name: '', title: 'Hairline', description: 'Cards, dividers, and quiet outlines', token: '--rs-border-width-sm' },
  { name: '-md', title: 'Emphasis', description: 'Outlined buttons and active states', token: '--rs-border-width-md' },
  { name: '-lg', title: 'Heavy', description: 'Callouts and strong emphasis', token: '--rs-border-width-lg' },
]

const overrideExample = `:root {
  --rs-radius-md: 14px;
}`

const consumeExample = `.rs-card {
  border-radius: var(--rs-radius-md);
}`
---

<Container padded>
  <Typography as="article">
    <h1>Borders &amp; Radius</h1>
    <p>
      Borders and corner rounding in Rocketship are token APIs on <code>:root</code>:
      <code>--rs-border-*</code> for line weights and <code>--rs-radius-*</code> for corners.
      Components never hard-code these values, so you reshape the whole library by overriding
      the variables.
    </p>
    <p>The radius scale has two steps plus a pill for fully-rounded controls.</p>
    <pre><code>{overrideExample}</code></pre>
    <p>Components keep using the same variable:</p>
    <pre><code>{consumeExample}</code></pre>
    <p>
      Components also expose opt-in override hooks named
      <code>--rs-&lt;component&gt;-&lt;part&gt;-&lt;property&gt;</code>. These are never defined by the
      library — set them anywhere in your own stylesheet, even on <code>:root</code>, and every
      component picks them up:
    </p>
    <pre><code>{instanceOverrideExample}</code></pre>
    <p>The tokens below are shown at their actual size.</p>
  </Typography>
</Container>

<Container>
  <Typography as="article">
    <h2>Border width</h2>
    <p>A small scale: hairline by default, heavier for emphasis.</p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    {widths.map((width) => (
      <Card as="li">
        <div
          style={`height: var(--rs-space-5); background: var(--rs-color-surface-elevated); border: var(--rs-border-width${width.name}) solid var(--rs-color-border);`}
          aria-hidden="true"
        />
        <p class="rs-card__title">{width.title}</p>
        <p class="rs-card__description">{width.description}</p>
        <span slot="meta" class="rs-card__token">{width.token}</span>
      </Card>
    ))}
  </Grid>
</Container>

<Container>
  <Typography as="article">
    <h2>Radius scale</h2>
    <p>Each swatch uses its token directly.</p>
  </Typography>
</Container>
<Container padded>
  <Grid as="ul" columns={3}>
    {radii.map((radius) => (
      <Card as="li">
        <div
          style={`width: var(--rs-space-7); height: var(--rs-space-7); background: var(--rs-color-accent); border-radius: var(--rs-radius-${radius.name});`}
          aria-hidden="true"
        />
        <p class="rs-card__title">Radius {radius.name}</p>
        <p class="rs-card__description">{radius.value}</p>
        <span slot="meta" class="rs-card__token">--rs-radius-{radius.name}</span>
      </Card>
    ))}
  </Grid>
</Container>
