---
import type { HTMLAttributes } from 'astro/types'

export type CardTag = 'div' | 'article' | 'section' | 'li'

type Props = {
  as?: CardTag
  class?: string
} & HTMLAttributes<'div'>

const { as = 'div', class: className, ...attrs } = Astro.props as Props
const Tag = as
---

<Tag {...attrs} class:list={['rs-card', className]}>
  <slot name="media" />
  <div class="rs-card__body">
    <slot />
    {
      Astro.slots.has('meta') ? (
        <div class="rs-card__meta">
          <slot name="meta" />
        </div>
      ) : null
    }
  </div>
</Tag>

<style is:global lang="scss">
  @use '../styles/mixins' as *;

  .rs-card {
    --rs-card-media-bg: #{rs-token(color-surface-elevated)};
    background: #{rs-token(color-surface)};
    border: var(--rs-card-border-width, #{rs-token(border-width-sm)}) solid
      var(--rs-card-border-color, #{rs-token(color-border)});
    border-radius: var(--rs-card-border-radius, #{rs-token(radius-md)});
    box-shadow: var(--rs-card-shadow, none);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;

    /// Consumer-written on the slotted image (or any block), like Figure's `__media`. Every card in
    /// a row crops to the same shape, so the row lines up.
    &__media {
      aspect-ratio: var(--rs-card-media-aspect-ratio, 16 / 9);
      background: var(--rs-card-media-bg);
      block-size: auto;
      display: block;
      inline-size: 100%;
      margin: 0;
      object-fit: cover;
    }

    &__body {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      gap: var(--rs-card-body-gap, #{rs-token(space-2)});
      padding: var(--rs-card-body-padding, #{rs-token(space-4)});
    }

    &__meta {
      color: #{rs-token(color-muted)};
      display: flex;
      flex-wrap: wrap;
      gap: var(--rs-card-meta-gap, #{rs-token(space-2)});
      margin-block-start: auto;
      min-inline-size: 0;
    }

    &__title {
      color: #{rs-token(color-fg)};
      font-size: var(--rs-card-title-font-size, #{rs-token(font-size-lg)});
      font-weight: var(--rs-card-title-font-weight, #{rs-token(font-weight-semibold)});
      line-height: #{rs-token(line-height-tight)};
      margin: 0;
    }

    &__description {
      color: #{rs-token(color-muted)};
      margin: 0;
    }

    /// The card's one link. Its `::after` covers the whole card, so the card is one click target
    /// that screen readers announce once, named by the title.
    &__link {
      color: inherit;
      text-decoration: none;

      &::after {
        border-radius: calc(
          var(--rs-card-border-radius, #{rs-token(radius-md)}) - var(
              --rs-card-border-width,
              #{rs-token(border-width-sm)}
            )
        );
        content: '';
        inset: 0;
        position: absolute;
      }

      &:hover {
        text-decoration: underline;
      }

      /// The ring goes on the overlay, inset, so focus outlines the whole card.
      &:focus-visible {
        outline: none;
      }

      &:focus-visible::after {
        outline: 2px solid #{rs-token(color-focus-ring)};
        outline-offset: -2px;
      }
    }
  }
</style>
