---
import type { HTMLAttributes } from 'astro/types'

type Props = {
  class?: string
} & HTMLAttributes<'div'>

const { class: className, ...attrs } = Astro.props as Props
---

<div {...attrs} class:list={['rs-field', className]}>
  <slot />
</div>

<style is:global lang="scss">
  @use '../styles/mixins' as *;

  .rs-field {
    display: flex;
    flex-direction: column;
    gap: var(--rs-field-gap, #{rs-token(space-2)});
    min-width: 0;

    &__hint {
      color: var(--rs-field-hint-color, #{rs-token(color-muted)});
      margin: 0;
    }

    &__error {
      color: var(--rs-field-error-color, #{rs-token(color-danger-text)});
      font-weight: var(--rs-field-error-font-weight, #{rs-token(font-weight-semibold)});
      margin: 0;
    }
  }
</style>
