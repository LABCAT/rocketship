---
import Container from '@labcat2020/rocketship/components/Container'
import Field from '@labcat2020/rocketship/components/Field'
import Input from '@labcat2020/rocketship/components/Input'
import Label from '@labcat2020/rocketship/components/Label'
import Stack from '@labcat2020/rocketship/components/Stack'
---

<Container size="content" padded>
  <Stack gap="large">
    <Field>
      <Label for="input-default">Website</Label>
      <Input id="input-default" type="url" placeholder="https://example.com" />
    </Field>
    <Field>
      <Label for="input-invalid">Email address</Label>
      <Input
        id="input-invalid"
        type="email"
        value="sam@"
        aria-invalid="true"
        aria-describedby="input-invalid-error"
      />
      <p class="rs-field__error" id="input-invalid-error">Enter an email address like sam@example.com.</p>
    </Field>
    <Field>
      <Label for="input-disabled">Account ID</Label>
      <Input id="input-disabled" value="acct_4821" disabled />
    </Field>
  </Stack>
</Container>
