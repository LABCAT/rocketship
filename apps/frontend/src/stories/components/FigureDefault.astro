---
import Container from '@labcat2020/rocketship/components/Container'
import Figure from '@labcat2020/rocketship/components/Figure'
import Stack from '@labcat2020/rocketship/components/Stack'
---

<Container size="content" padded>
  <Stack>
    <Figure>
      <img
        class="rs-figure__media"
        src="/story-assets/artemis-ii-pad-sunset.webp"
        width="1200"
        height="795"
        alt="The SLS rocket and Orion spacecraft on Launch Pad 39B, silhouetted against an orange sunset between two lightning towers."
      />
      <Fragment slot="caption">
        Artemis II on Launch Pad 39B at Kennedy Space Center, March 2026.{' '}
        <cite>NASA/Sam Lott</cite>
      </Fragment>
    </Figure>
  </Stack>
</Container>
